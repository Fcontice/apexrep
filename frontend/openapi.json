  "components": {
    "schemas": {
      "ErrorResponse": {
        "properties": {
          "detail": {
            "type": "string",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "detail"
        ],
        "title": "ErrorResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "worker_alive": {
            "type": "boolean",
            "title": "Worker Alive"
          },
          "worker_heartbeat_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Worker Heartbeat At"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "worker_alive",
          "worker_heartbeat_at"
        ],
        "title": "HealthResponse"
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded",
          "down"
        ],
        "title": "HealthStatus"
      },
      "HistoryPoint": {
        "properties": {
          "taken_at": {
            "type": "string",
            "format": "date-time",
            "title": "Taken At"
          },
          "level": {
            "type": "integer",
            "title": "Level"
          },
          "level_prestige": {
            "type": "integer",
            "title": "Level Prestige"
          },
          "level_progress": {
            "type": "integer",
            "title": "Level Progress"
          },
          "rank_score": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank Score"
          },
          "selected_legend": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Selected Legend"
          },
          "trackers": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Trackers"
          }
        },
        "type": "object",
        "required": [
          "taken_at",
          "level",
          "level_prestige",
          "level_progress",
          "rank_score",
          "selected_legend",
          "trackers"
        ],
        "title": "HistoryPoint"
      },
      "HistoryResponse": {
        "properties": {
          "points": {
            "items": {
              "$ref": "#/components/schemas/HistoryPoint"
            },
            "type": "array",
            "title": "Points"
          },
          "bucketed": {
            "type": "boolean",
            "title": "Bucketed"
          }
        },
        "type": "object",
        "required": [
          "points",
          "bucketed"
        ],
        "title": "HistoryResponse"
      },
      "MapRotation": {
        "properties": {
          "battle_royale": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ModeRotation"
              },
              {
                "type": "null"
              }
            ]
          },
          "ranked": {
            "anyOf": [
