              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Level Progress Delta"
          },
          "rank_score_delta": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Rank Score Delta"
