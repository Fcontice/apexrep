            "type": "string",
            "title": "Map"
          },
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date-time",
            "title": "End"
          }
        },
        "type": "object",
        "required": [
          "map",
          "start",
          "end"
        ],
        "title": "MapSlot"
