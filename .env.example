# Copy to .env in the repo root. Docker Compose reads it, and the backend and
# worker read it when run outside Docker.

# Local Docker Postgres is published on host port 5433.
DATABASE_URL=postgresql://apexrep:apexrep@localhost:5433/apexrep

# Apex Legends Status API key (https://apexlegendsapi.com). Never commit it.
ALS_API_KEY=

# Shared secret the Next.js server sends to the backend (used from Phase 3).
INTERNAL_TOKEN=

# ALS rate budget: the 5 requests/second limit split between the two processes.
ALS_RATE_BACKEND_PER_S=1.5
ALS_RATE_WORKER_PER_S=3
ALS_MAX_RETRIES=2
ALS_RETRY_BACKOFF_S=1

# Worker
WORKER_LOOP_INTERVAL_S=30
WORKER_HEARTBEAT_STALE_S=90

# Frontend: put this in frontend/.env.local when running `npm run dev`.
BACKEND_URL=http://localhost:8000
