# Copy to .env in the repo root. Docker Compose reads it, and the backend and
# worker read it when run outside Docker.

# Local Docker Postgres is published on host port 5433.
DATABASE_URL=postgresql://apexrep:apexrep@localhost:5433/apexrep

# Apex Legends Status API key (https://apexlegendsapi.com). Never commit it.
ALS_API_KEY=

# Shared secret the Next.js server sends to the backend. The backend rejects
# every request without it. Use a long random value in production.
INTERNAL_TOKEN=dev-internal-token

# ALS rate budget: the 5 requests/second limit split between the two processes.
ALS_RATE_BACKEND_PER_S=1.5
ALS_RATE_WORKER_PER_S=3
ALS_MAX_RETRIES=2
ALS_RETRY_BACKOFF_S=1

# Per-visitor limits: lookups per 5 minutes and track requests per hour.
IP_LIMIT_RESOLVE_COUNT=30
IP_LIMIT_TRACK_COUNT=10

# Backend /docs and /openapi.json. Development only; leave unset in production.
EXPOSE_API_DOCS=false

# Worker
WORKER_LOOP_INTERVAL_S=30
WORKER_HEARTBEAT_STALE_S=90

# Frontend: put these two in frontend/.env.local when running `npm run dev`.
# INTERNAL_TOKEN must match the backend's.
BACKEND_URL=http://localhost:8000
# Public address of the site, for canonical and link-preview URLs.
SITE_URL=https://apexrep.xyz
